{
  "name": "@forgeagent/cli",
  "type": "module",
  "version": "0.1.0",
  "description": "ForgeAgent OS CLI",
  "license": "MIT",
  "keywords": [
    "forgeagent",
    "agent",
    "cli",
    "ai",
    "agent-os"
  ],
  "bin": {
    "forgeagent": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist temp",
