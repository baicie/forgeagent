    "test": "vitest"
  },
  "dependencies": {
    "@forgeagent/core": "workspace:*",
    "@forgeagent/runner": "workspace:*",
    "commander": "^15.0.0",
    "dotenv": "^16.5.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
