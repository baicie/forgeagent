{
  "extends": "../../scripts/tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "paths": {
      "@forgeagent/core": ["../../packages/core/src/index.ts"],
      "@forgeagent/core/*": ["../../packages/core/src/*"],
      "@forgeagent/runner": ["../../packages/runner/src/index.ts"],
      "@forgeagent/runner/*": ["../../packages/runner/src/*"]
    },
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "../../packages/core/src/**/*",
    "../../packages/runner/src/**/*"
  ],
  "exclude": ["**/dist"]
}
